# letsstudyms.com: rules used while Hostinger serves dist/ as static files.
# server.js applies the same rules when the site runs as a Node app.
# The marker line under "4. Old URLs" is replaced at build time with the redirects from src/data/site.js.

AddType text/javascript .js .mjs
AddType text/markdown .md
AddDefaultCharset utf-8
Options -Indexes -MultiViews

# Pages are prerendered as /about/index.html but their canonical URL is /about (no slash).
# Without this, the server answers /about with a 301 to /about/, contradicting the canonical tag.
DirectorySlash Off

# Unknown URLs get a real 404 status (not the home page with 200, which Google calls a "soft 404").
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. One hostname: www.letsstudyms.com -> letsstudyms.com (the CDN already sends http -> https)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

    # 2. Prerendered files are only reachable through their clean URL
    RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
    RewriteRule ^ / [R=301,L]
    RewriteCond %{THE_REQUEST} \s/(.+)/index\.html[\s?]
    RewriteRule ^ /%1 [R=301,L]

    # 3. Canonical URLs have no trailing slash (except the home page)
    RewriteCond %{REQUEST_URI} ^/(.+)/$
    RewriteRule ^ /%1 [R=301,L]

    # 4. Old URLs
@@REDIRECTS@@

    # 5. Clean URL -> prerendered page file
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.html -f
    RewriteRule ^(.+)$ /$1/index.html [L]
</IfModule>
